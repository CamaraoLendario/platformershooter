[sub_resource type="Shader" id="Shader_r07xa"]
code = "shader_type canvas_item;
uniform int frame = 0;
uniform vec3 eyeColor: source_color;
uniform vec2 lookDir;
const vec2[2] eyeCenterPoss = vec2[2](
	vec2(0.375, 0.25),
	vec2(0.688, 0.25)
);

void fragment() {
	vec2 uv = UV * vec2(3., 1.);
	uv -= vec2(0., 0.);
	for (int i = 0; i < 2; i++){
	vec2 dirVec = uv - ((eyeCenterPoss[i] + float(frame) * vec2(1, 0)) + (lookDir * TEXTURE_PIXEL_SIZE * vec2(1.5, 0.5)));
		if (dirVec.x < TEXTURE_PIXEL_SIZE.x*1.5 && dirVec.y < TEXTURE_PIXEL_SIZE.x*1.5 && dirVec.x > -TEXTURE_PIXEL_SIZE.x*1.5 && dirVec.y > -TEXTURE_PIXEL_SIZE.x*1.5){
			COLOR.rgba = vec4(eyeColor, 1.);
	}}
}

//void light() {
//	// Called for every pixel for every light affecting the CanvasItem.
//	// Uncomment to replace the default light processing function with this one.
//}
"

